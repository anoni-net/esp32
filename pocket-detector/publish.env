# tools/publish_firmware.sh 與 tools/promote_firmware.sh 讀的設定。
# assets.anoni.net 上的目錄：正式通道 CHANNEL/，測試通道 CHANNEL-test/。
# 已經燒進板子的版本讀 esp32-tracker/，要跟 pocket_detector.ino 的 NETUPDATE_URL_* 一致
CHANNEL=esp32-tracker
# PlatformIO 的環境名稱
PIO_ENV=esp32-s3-n16r8
# 每次發布都重新編譯這個檔案，建置時間才會是這一次的
SKETCH=pocket_detector/pocket_detector.ino
# 韌體裡標記建置時間的字串（pocket_detector.ino 的 BUILD_TAG）
BUILD_MARKER=TRKBUILD
# 發布的檔名是 PREFIX-SHA-256 前 12 碼.bin
PREFIX=tracker
