<!doctype html>
<html lang="zh-Hant-TW">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}{% if path %} · anoni.net ESP32 工坊{% else %} · anoni.net{% endif %}</title>
<meta name="description" content="{{ description }}">
{# 分享卡照 anoni-net/www 的 _layout.html.j2，og.png 是 1200x630 #}
<meta property="og:title" content="{{ title }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ base }}{{ path }}">
<meta property="og:image" content="{{ og_image }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="ESP32 工坊：用 ESP32-S3 開發板做的隱私工具">
<meta property="og:site_name" content="anoni.net">
<meta property="og:description" content="{{ description }}">
<meta property="og:locale" content="zh_TW">
<meta name="twitter:card" content="summary_large_image">
{% if path == '404.html' %}
<meta name="robots" content="noindex">
{% elif target == 'clearnet' %}
<link rel="canonical" href="https://anoni.net/esp32/{{ path }}">
<meta http-equiv="onion-location" content="{{ onion_location }}">
{% endif %}
<link rel="icon" href="{{ asset('logo.svg') }}" type="image/svg+xml">
<link rel="stylesheet" href="{{ asset('site.css') }}">
{% block head %}{% endblock %}
</head>
<body>
<div class="sheet">
<a class="skip" href="#main">跳到主要內容</a>
<header>
  {# 同 Gears、Vessel 與新聞導讀：anoni.net 的字標、分隔線、產品名稱 #}
  <a class="brand" href="{{ root }}">
    <picture>
      <source srcset="{{ asset('logo-wordmark-white.svg') }}" media="(prefers-color-scheme: dark)">
      <img class="brand__logo" src="{{ asset('logo-wordmark-tonal.svg') }}" alt="anoni.net" width="116" height="28">
    </picture>
    <span class="brand__product">ESP32 工坊</span>
  </a>
  <nav class="main" aria-label="主要">
    {% for t in nav_tools %}<a href="{{ root }}{{ t.slug }}/"{% if path == t.slug + '/' %} aria-current="page"{% endif %}>{{ t.name }}</a>
    {% endfor %}{% for p, label in [('install/', '安裝韌體'), ('connect/', '連上板子'), ('about-esp32/', 'ESP32 是什麼'), ('developers/', '給開發者')] %}<a href="{{ root }}{{ p }}"{% if path == p %} aria-current="page"{% endif %}>{{ label }}</a>
    {% endfor %}
  </nav>
</header>
<main id="main">
{% block main %}{% endblock %}
</main>
{# 頁尾照 anoni-net/www 的 _layout.html.j2：聯絡方式與社群的網站、onion 位址、授權 #}
<footer>
  <div class="cols">
    <a href="mailto:whisper@anoni.net">{{ icon('email-outline') }}whisper@anoni.net</a>
    <a href="https://anoni.net/contact/#pgp">{{ icon('key-variant') }}PGP 公鑰</a>
    <a href="https://form.anoni.net/s/cmc9ceju1000dlj017fiathzq">{{ icon('rss') }}訂閱電子報</a>
    <a href="https://anoni.net/contact/">{{ icon('card-account-mail-outline') }}聯絡方式</a>
    <a href="https://anoni.net/docs/">{{ icon('folder-open-outline') }}文件 anoni.net/docs</a>
    <a href="https://anoni.net/news/">{{ icon('newspaper-variant-outline') }}新聞導讀 anoni.net/news</a>
  </div>
  <p class="onion">{{ icon('simple-torproject') }}Onion 位址：esp32.anoninetru5tflukgfaehun7q6khowgmymcff3gtk5oyesqazhmfxtyd.onion{% if target == 'onion' %}。網頁安裝需要 Chrome 或 Edge 的 Web Serial，Tor Browser 沒有這個功能{% endif %}</p>
  <p class="license">{{ icon('octicons-mark-github-24') }}由<a href="https://anoni.net/">匿名網路社群 anoni.net</a> 開發，<a href="{{ repo }}">原始碼</a>以 MIT 授權釋出</p>
</footer>
</div>
</body>
</html>
