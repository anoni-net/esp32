<!doctype html>
<html lang="zh-Hant-TW">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}{% if path %} · anoni.net ESP32 小工具{% else %} · anoni.net{% endif %}</title>
<meta name="description" content="{% block description %}匿名網路社群 anoni.net 用 ESP32-S3 開發板做的隱私小工具：隨身偵測器找出跟著你的藍牙追蹤器，也能檢查旅館房間與會議室。原始碼公開。{% endblock %}">
{% if target == 'clearnet' %}<link rel="canonical" href="https://anoni.net/esp32/{{ path }}">
{% endif %}{% if onion_location %}<meta http-equiv="onion-location" content="{{ onion_location }}">
{% endif %}
<link rel="icon" href="{{ root }}static/logo.svg" type="image/svg+xml">
<link rel="stylesheet" href="{{ root }}static/site.css">
{% block head %}{% endblock %}
</head>
<body>
<div class="sheet">
<a class="skip" href="#main">跳到主要內容</a>
<header>
  <a class="brand" href="{{ root }}"><img class="logo" src="{{ root }}static/logo.svg" alt="" width="24" height="24">ESP32 小工具</a>
  <nav class="main" aria-label="主要">
    {% for t in nav_tools %}<a href="{{ root }}{{ t.slug }}/"{% if path == t.slug + '/' %} aria-current="page"{% endif %}>{{ t.name }}</a>
    {% endfor %}<a href="{{ root }}about-esp32/"{% if path == 'about-esp32/' %} aria-current="page"{% endif %}>ESP32 是什麼</a>
    <a href="{{ root }}install/"{% if path == 'install/' %} aria-current="page"{% endif %}>安裝韌體</a>
  </nav>
</header>
<main id="main">
{% block main %}{% endblock %}
</main>
<footer>
  <p>由 <a href="https://anoni.net/">匿名網路社群 anoni.net</a> 開發，<a href="{{ repo }}">原始碼</a>以 MIT 授權釋出，歡迎回報問題與一起改進。</p>
  {% if target == 'onion' %}<p>你正在使用 onion 版本。網頁安裝需要 Chrome 或 Edge 的 Web Serial，Tor Browser 沒有這個功能。</p>{% endif %}
</footer>
</div>
</body>
</html>
