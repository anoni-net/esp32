<!doctype html>
<html lang="zh-Hant-TW">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}{% if path %} · anoni.net ESP32 小工具{% else %} · anoni.net{% endif %}</title>
<meta name="description" content="{{ description }}">
{# 分享卡照 anoni-net/www 的 _layout.html.j2，og.png 是 1200x630 #}
<meta property="og:title" content="{{ title }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ base }}{{ path }}">
<meta property="og:image" content="{{ og_image }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="ESP32 小工具：用 ESP32-S3 開發板做的隱私小工具">
<meta property="og:site_name" content="anoni.net">
<meta property="og:description" content="{{ description }}">
<meta property="og:locale" content="zh_TW">
<meta name="twitter:card" content="summary_large_image">
{% if path == '404.html' %}
<meta name="robots" content="noindex">
{% elif target == 'clearnet' %}
<link rel="canonical" href="https://anoni.net/esp32/{{ path }}">
<meta http-equiv="onion-location" content="{{ onion_location }}">
{% endif %}
<link rel="icon" href="{{ asset('logo.svg') }}" type="image/svg+xml">
<link rel="stylesheet" href="{{ asset('site.css') }}">
{% block head %}{% endblock %}
</head>
<body>
<div class="sheet">
<a class="skip" href="#main">跳到主要內容</a>
<header>
  <a class="brand" href="{{ root }}"><img class="logo" src="{{ asset('logo.svg') }}" alt="" width="24" height="24">ESP32 小工具</a>
  <nav class="main" aria-label="主要">
    {% for t in nav_tools %}<a href="{{ root }}{{ t.slug }}/"{% if path == t.slug + '/' %} aria-current="page"{% endif %}>{{ t.name }}</a>
    {% endfor %}{% for p, label in [('install/', '安裝韌體'), ('connect/', '連上板子'), ('about-esp32/', 'ESP32 是什麼'), ('developers/', '給開發者')] %}<a href="{{ root }}{{ p }}"{% if path == p %} aria-current="page"{% endif %}>{{ label }}</a>
    {% endfor %}
  </nav>
</header>
<main id="main">
{% block main %}{% endblock %}
</main>
<footer>
  <p>由 <a href="https://anoni.net/">匿名網路社群 anoni.net</a> 開發，<a href="{{ repo }}">原始碼</a>以 MIT 授權釋出，歡迎回報問題與一起改進。</p>
  {% if target == 'onion' %}<p>你正在使用 onion 版本。網頁安裝需要 Chrome 或 Edge 的 Web Serial，Tor Browser 沒有這個功能。</p>{% endif %}
</footer>
</div>
</body>
</html>
